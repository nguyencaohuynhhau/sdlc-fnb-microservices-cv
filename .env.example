# Sao chép thành .env rồi điền giá trị. .env KHÔNG BAO GIỜ được commit.
POSTGRES_PASSWORD=change-me-postgres
# Tối thiểu 32 byte (HS256). Sinh bằng: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-bytes
# Danh sách origin cho CORS, phân cách bằng dấu phẩy. Không bao giờ dùng *
CORS_ORIGINS=http://localhost:5173
# Mật khẩu chung cho 3 tài khoản demo (owner/cashier/kitchen), tối thiểu 8 ký tự
SEED_PASSWORD=change-me-seed
# Seeder và auto-migrate CHỈ chạy khi Development. Môi trường thật: đặt Production.
ASPNETCORE_ENVIRONMENT=Development
